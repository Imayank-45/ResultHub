# ResultAI Environment Variables Example
# Copy this file to .env and configure your credentials.

# SMTP Email Notification Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=ResultAI <noreply@resultai.com>
SMTP_TLS=true

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Apps Script Web App Endpoint for Feedback Form
VITE_FEEDBACK_API_URL=https://script.google.com/macros/s/AKfycbyKNzAWQ8QZWX695Ssv_5d-rYE6Xy2TCWnrOzldlz-DcEOofkeRe9loF4OjoZSUaG8/exec